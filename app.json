{
  "expo": {
    "name": "YAPPIE",
    "slug": "social-discovery",
    "version": "0.1.3",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/brand/yappie-logo-transparent.png",
    "scheme": "socialdiscovery",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3708b603-811a-4757-a013-f99e42f52076",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "photosPermission": "Allow YAPPIE to choose one profile picture."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0F12",
          "image": "./assets/brand/yappie-logo-transparent.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "@cloudflare/react-native-webrtc"
    ],
    "android": {
      "package": "com.socialdiscovery.app",
      "versionCode": 7,
      "adaptiveIcon": {
        "backgroundColor": "#0D0F12",
        "foregroundImage": "./assets/brand/yappie-logo-transparent.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": true
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3708b603-811a-4757-a013-f99e42f52076"
      }
    },
    "owner": "dexasan"
  }
}
